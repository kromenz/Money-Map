# A pasta com os ficheiros .xlsx do orcamento. Se estiver definida, a app
# importa tudo o que la estiver ao arrancar, e essa pasta passa a ser a fonte
# da verdade. Se nao estiver, nada muda: importa-se arrastando ficheiros.
#
# Sem o prefixo NEXT_PUBLIC_ de proposito: o caminho fica do lado servidor e
# nunca chega ao browser.
BUDGET_FOLDER=D:\budget

# Onde a API responde. O valor abaixo e o predefinido.
NEXT_PUBLIC_API_BASE=http://localhost:5000
